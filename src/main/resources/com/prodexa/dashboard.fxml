<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.prodexa.controller.DashboardController"
            prefHeight="800.0" prefWidth="600.0"
            stylesheets="@dashboardStyles.css">

    <Label alignment="CENTER" layoutX="141.0" prefHeight="54.0" prefWidth="336.0"
           styleClass="dashboard-title" text="Dashboard"/>

    <Label fx:id="keyLabel" layoutX="208.0" layoutY="67.0"
           styleClass="stats-label" text="Keys Pressed: 0"/>

    <Label fx:id="mouseLabel" layoutX="207.0" layoutY="128.0"
           prefHeight="42.0" prefWidth="208.0"
           styleClass="stats-label" text="Mouse Clicks: 0"/>

    <Button fx:id="startButton" layoutX="150.0" layoutY="200.0"
            text="Start Monitoring" onAction="#handleStartButton"/>

    <Button fx:id="breakButton" layoutX="300.0" layoutY="200.0"
            text="Take Break" onAction="#handleBreakButton"/>

    <Button fx:id="stopButton" layoutX="450.0" layoutY="200.0"
            text="Stop Monitoring" onAction="#handleStopButton"/>

<!--    <Button text="Test Screenshot" onAction="#handleTestScreenshot" />-->
<!--    <Button text="Test Webcam" onAction="#handleTestWebcam" />-->

</AnchorPane>
