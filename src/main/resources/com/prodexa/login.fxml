<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>


<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.prodexa.controller.LoginController"
            prefWidth="800" prefHeight="600"
            stylesheets="@loginstyles.css">

    <VBox alignment="CENTER"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <VBox spacing="20" alignment="CENTER" maxWidth="420" styleClass="login-card">

            <Label text="PRODEXA" styleClass="header-label"/>

            <Button fx:id="loginButton" text="Login" onAction="#handleLogin" styleClass="login-button"/>

            <Label fx:id="statusLabel" textFill="red" wrapText="true" styleClass="status-label"/>
        </VBox>
    </VBox>
</AnchorPane>